{
  "author": {
    "name": "Robert Lindley"
  },
  "bugs": {
    "url": "https://github.com/Coderrob/typescript-ast/issues"
  },
  "description": "Policy-agnostic AST navigation helpers with optional TypeScript ESTree extensions",
  "devDependencies": {
    "@coderrob/eslint-plugin-zero-tolerance": "1.2.4",
    "@coderrob/typescript-type-guards": "^1.0.1",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript-eslint/types": "^8.71.0",
    "@typescript-eslint/typescript-estree": "^8.71.0",
    "@typescript-eslint/visitor-keys": "^8.71.0",
    "@vitest/coverage-istanbul": "^5.0.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.3",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tinybench": "^6.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "default": "./dist/core.cjs"
    },
    "./typescript": {
      "import": {
        "types": "./dist/typescript.d.mts",
        "default": "./dist/typescript.mjs"
      },
      "require": {
        "types": "./dist/typescript.d.cts",
        "default": "./dist/typescript.cjs"
      },
      "default": "./dist/typescript.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Coderrob/typescript-ast#readme",
  "keywords": [
    "typescript",
    "ast",
    "eslint",
    "analysis"
  ],
  "license": "Apache-2.0",
  "lint-staged": {
    "**/*.{js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "name": "@coderrob/typescript-ast",
  "peerDependencies": {
    "@typescript-eslint/types": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/typescript-ast.git"
  },
  "scripts": {
    "bench": "npm run bench:check && npm run build && node benchmarks/index.js",
    "bench:check": "node benchmarks/check-coverage.js",
    "build": "npm run clean && tsup --config tsup.config.ts && node scripts/build-types-dual.mjs",
    "ci": "npm run bench:check && npm run release:check && npm run quality && npm run build && npm run deps:circular && npm run publint && npm run pack:smoke",
    "clean": "rimraf dist coverage",
    "deps:circular": "madge --circular --extensions ts src/index.ts src/core.ts src/typescript.ts",
    "deps:graph": "madge --extensions ts src/index.ts src/core.ts src/typescript.ts",
    "duplication": "jscpd src/ast src/guards src/internal src/index.ts src/core.ts src/typescript.ts src/import-paths.ts --min-lines 5 --min-tokens 50 --threshold 1 --reporters console",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pack:dry-run": "npm pack --dry-run",
    "pack:smoke": "node scripts/check-packed-package.mjs",
    "prepack": "npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run release",
    "publint": "publint",
    "publish:package": "npm publish",
    "quality": "npm run format:check && npm run lint && npm run duplication && npm run typecheck && npm run test:coverage",
    "release": "npm run quality && npm run build && npm run deps:circular && npm run publint",
    "release:check": "node --test scripts/__tests__/release.test.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "sideEffects": false,
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "version": "1.0.0",
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
