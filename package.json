{
  "author": {
    "name": "Robert Lindley"
  },
  "bugs": {
    "url": "https://github.com/Coderrob/typescript-ast/issues"
  },
  "dependencies": {
    "@coderrob/typescript-type-guards": "^1.0.1"
  },
  "description": "Policy-agnostic AST navigation helpers with optional TypeScript ESTree extensions",
  "devDependencies": {
    "@coderrob/eslint-plugin-zero-tolerance": "^1.2.3",
    "@emnapi/core": "^1.9.2",
    "@emnapi/runtime": "^1.9.2",
    "@emnapi/wasi-threads": "^1.2.1",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/types": "^8.0.0",
    "@typescript-eslint/typescript-estree": "^8.0.0",
    "@typescript-eslint/visitor-keys": "^8.0.0",
    "@vitest/coverage-istanbul": "^4.1.2",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "rimraf": "^6.1.3",
    "tinybench": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.cjs"
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      },
      "default": "./dist/core.cjs"
    },
    "./typescript": {
      "import": {
        "types": "./dist/typescript.d.mts",
        "default": "./dist/typescript.mjs"
      },
      "require": {
        "types": "./dist/typescript.d.cts",
        "default": "./dist/typescript.cjs"
      },
      "default": "./dist/typescript.cjs"
    }
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "dist/**/*.d.mts",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Coderrob/typescript-ast#readme",
  "keywords": [
    "typescript",
    "ast",
    "eslint",
    "analysis"
  ],
  "license": "Apache-2.0",
  "lint-staged": {
    "**/*.{js,cjs,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "main": "dist/index.cjs",
  "name": "@coderrob/typescript-ast",
  "peerDependencies": {
    "@typescript-eslint/types": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/typescript-ast.git"
  },
  "scripts": {
    "benchmark": "npm run benchmark:run",
    "benchmark:check": "node benchmarks/check-coverage.js",
    "benchmark:run": "npm run benchmark:check && npm run build && node benchmarks/index.js",
    "build": "npm run clean && tsup --config tsup.config.ts && npm run build:types && npm run build:types:dual",
    "build:types": "tsc -p tsconfig.build.json",
    "build:types:dual": "node scripts/build-types-dual.mjs",
    "check": "npm run format:check && npm run lint && npm run duplication && npm run typecheck && npm run test:coverage",
    "clean": "rimraf dist coverage",
    "deps:circular": "madge --circular --extensions ts src/index.ts",
    "deps:graph": "madge --extensions ts src/index.ts",
    "duplication": "jscpd src/ast src/guards src/internal src/index.ts src/import-paths.ts --min-lines 5 --min-tokens 50 --threshold 1 --reporters console",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "pack:dry-run": "npm run release:pack:dry-run",
    "prepare": "husky",
    "publish:package": "npm publish",
    "prepublishOnly": "npm run release:prepublish",
    "publint": "publint",
    "release:pack:dry-run": "npm pack --dry-run",
    "release:prepublish": "npm run clean && npm run build && npm run check && npm run deps:circular && npm run publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "version": "0.1.0"
}
